          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Classement décroissant ordonné', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    if (json.data.length > 1) {",
                  "        pm.expect(json.data[0].moyenneGenerale).to.be.at.least(json.data[1].moyenneGenerale);",
                  "    }",
                  "});"
