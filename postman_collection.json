    {
      "name": "8. Service Web SOAP 1.1 (WSDL)",
      "item": [
        {
          "name": "8.1 Télécharger le contrat WSDL SOAP (?wsdl)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Contrat WSDL retourné avec syntaxe XML', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('content-type')).to.include('xml');",
