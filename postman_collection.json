                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/soap?wsdl", "host": ["{{baseUrl}}"], "path": ["soap"], "query": [{ "key": "wsdl", "value": "" }] }
          }
        },
        {
          "name": "8.2 Invoquer l'opération SOAP CalculerMoyenneEtudiant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Enveloppe SOAP de réponse reçue avec succès', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include('CalculerMoyenneEtudiantResponse');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
              { "key": "SOAPAction", "value": "http://univ.tn/scolarite/soap/CalculerMoyenneEtudiant" }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:soap=\"http://univ.tn/scolarite/soap\">\n  <soapenv:Body>\n    <soap:CalculerMoyenneEtudiantRequest>\n      <etudiantId>etud_1</etudiantId>\n    </soap:CalculerMoyenneEtudiantRequest>\n  </soapenv:Body>\n</soapenv:Envelope>"
            },
            "url": { "raw": "{{baseUrl}}/soap", "host": ["{{baseUrl}}"], "path": ["soap"] }
          }
        }
      ]
