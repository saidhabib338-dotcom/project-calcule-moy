    {
      "name": "5. Délibérations & Règles LMD",
      "item": [
        {
          "name": "5.1 Délibération individuelle et calcul LMD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Calcul de délibération conforme LMD', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.statut).to.be.oneOf(['Admis', 'Admis par Rachat', 'Ajourné']);",
                  "    pm.expect(json.data.mention).to.be.a('string');",
                  "    pm.expect(json.data.creditsValides).to.be.at.least(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/deliberations/etudiant/etud_1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "deliberations", "etudiant", "etud_1"] }
          }
        },
